{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-bootcamp-team4/CaffeMate/docs/contracts/evidence-record.schema.json",
  "title": "CaffeMate Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "project_id",
    "claim_type",
    "value",
    "value_kind",
    "geographic_scope",
    "source",
    "original_anchor",
    "freshness_status",
    "conflict_status",
    "retrieved_at",
    "missing_context",
    "durable_evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "value": {
      "$ref": "./common-types.schema.json#/$defs/typedValue"
    },
    "value_kind": {
      "enum": [
        "EVIDENCED_FACT",
        "USER_CONFIRMED_FACT",
        "DECLARED_ASSUMPTION",
        "DERIVED_RESULT",
        "UNKNOWN"
      ]
    },
    "unit": {
      "type": ["string", "null"]
    },
    "geographic_scope": {
      "$ref": "./common-types.schema.json#/$defs/geographicScope"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source_ref", "authority", "source_type", "published_or_data_date", "source_observed_at"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "PRIMARY_OFFICIAL",
            "COMPANY_OFFICIAL",
            "PRIMARY_DATA",
            "VALIDATED_BENCHMARK",
            "USER_ARTIFACT",
            "SECONDARY"
          ]
        },
        "source_type": {
          "enum": ["API", "DATASET", "WEB", "PDF", "USER_DOCUMENT", "USER_FIELD"]
        },
        "source_family": {
          "type": "string",
          "minLength": 1
        },
        "published_or_data_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "source_observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "document_version": {
          "type": ["string", "null"]
        },
        "checksum": {
          "type": ["string", "null"]
        }
      }
    },
    "original_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_type", "locator"],
      "properties": {
        "anchor_type": {
          "enum": ["API_ROW", "DATASET_ROW", "PAGE", "TABLE", "SECTION", "USER_FIELD", "CALCULATION"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt_hash": {
          "type": ["string", "null"]
        }
      }
    },
    "freshness_status": {
      "enum": ["FRESH", "STALE", "UNKNOWN", "NOT_APPLICABLE"]
    },
    "conflict_status": {
      "enum": ["NONE", "POTENTIAL", "CONFIRMED", "RESOLVED"]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "durable_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "value_kind": { "const": "UNKNOWN" } } },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "properties": { "kind": { "const": "NULL" }, "value": { "const": null } },
            "required": ["kind", "value"]
          },
          "freshness_status": { "const": "UNKNOWN" },
          "missing_context": { "type": "array", "minItems": 1 },
          "durable_evidence_refs": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "value_kind": { "const": "DECLARED_ASSUMPTION" } } },
      "then": {
        "properties": {
          "freshness_status": { "const": "NOT_APPLICABLE" },
          "durable_evidence_refs": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "freshness_status": { "const": "FRESH" } } },
      "then": {
        "properties": {
          "source": {
            "type": "object",
            "anyOf": [
              {
                "type": "object",
                "properties": { "published_or_data_date": { "type": "string" } },
                "required": ["published_or_data_date"]
              },
              {
                "type": "object",
                "properties": { "source_observed_at": { "type": "string" } },
                "required": ["source_observed_at"]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_kind": { "enum": ["EVIDENCED_FACT", "USER_CONFIRMED_FACT", "DERIVED_RESULT"] }
        }
      },
      "then": {
        "properties": {
          "value": {
            "not": {
              "type": "object",
              "properties": { "kind": { "const": "NULL" } },
              "required": ["kind"]
            }
          }
        }
      }
    }
  ]
}
