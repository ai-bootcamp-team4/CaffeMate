{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-bootcamp-team4/CaffeMate/docs/contracts/agent-task-result.schema.json",
  "title": "CaffeMate Agent Task Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "invocation_id",
    "agent_name",
    "task_type",
    "workflow_run_id",
    "stage_run_id",
    "venture_project_id",
    "head_fence_seen",
    "input_digest",
    "output_schema_id",
    "status",
    "payload",
    "evidence_refs",
    "missing_claim_ids",
    "reason_codes",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_name": {
      "enum": [
        "INTENT_INTERPRETER",
        "EVIDENCE_RESEARCHER",
        "PROPOSAL_AGENT",
        "DOCUMENT_ANALYST",
        "TYPED_CANDIDATE_AUDITOR"
      ]
    },
    "task_type": {
      "enum": [
        "INTENT_DELTA",
        "EVIDENCE_PLAN",
        "EVIDENCE_ASSESS",
        "PROPOSE_INDEPENDENT",
        "PROPOSE_FRANCHISE",
        "DOCUMENT_EXTRACT",
        "CANDIDATE_AUDIT"
      ]
    },
    "workflow_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stage_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "venture_project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "head_fence_seen": {
      "$ref": "./agent-task.schema.json#/$defs/headFence"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output_schema_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": ["COMPLETE", "NEEDS_EVIDENCE", "NEEDS_HUMAN", "ABSTAIN", "INVALID"]
    },
    "payload": {
      "type": ["object", "null"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "missing_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "./common-types.schema.json#/$defs/reasonCode"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "COMPLETE" } }
      },
      "then": {
        "properties": { "payload": { "type": "object" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "INVALID" } }
      },
      "then": {
        "properties": {
          "payload": { "const": null },
          "reason_codes": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "NEEDS_EVIDENCE" } }
      },
      "then": {
        "properties": {
          "missing_claim_ids": { "type": "array", "minItems": 1 },
          "reason_codes": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["NEEDS_HUMAN", "ABSTAIN"] }
        }
      },
      "then": {
        "properties": {
          "reason_codes": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "task_type": { "const": "INTENT_DELTA" } }
      },
      "then": {
        "properties": {
          "agent_name": { "const": "INTENT_INTERPRETER" },
          "output_schema_id": { "const": "caffemate.agent.intent-result.v1" },
          "payload": {
            "anyOf": [
              { "$ref": "./agent-role-payloads.schema.json#/$defs/intentResult" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "task_type": { "const": "EVIDENCE_PLAN" } }
      },
      "then": {
        "properties": {
          "agent_name": { "const": "EVIDENCE_RESEARCHER" },
          "output_schema_id": { "const": "caffemate.agent.evidence-plan-result.v1" },
          "payload": {
            "anyOf": [
              { "$ref": "./agent-role-payloads.schema.json#/$defs/evidencePlanResult" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "task_type": { "const": "EVIDENCE_ASSESS" } }
      },
      "then": {
        "properties": {
          "agent_name": { "const": "EVIDENCE_RESEARCHER" },
          "output_schema_id": { "const": "caffemate.agent.evidence-assess-result.v1" },
          "payload": {
            "anyOf": [
              { "$ref": "./agent-role-payloads.schema.json#/$defs/evidenceAssessResult" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "task_type": { "const": "PROPOSE_INDEPENDENT" } }
      },
      "then": {
        "properties": {
          "agent_name": { "const": "PROPOSAL_AGENT" },
          "output_schema_id": { "const": "caffemate.agent.independent-proposal-result.v1" },
          "payload": {
            "anyOf": [
              { "$ref": "./agent-role-payloads.schema.json#/$defs/independentProposalResult" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "task_type": { "const": "PROPOSE_FRANCHISE" } }
      },
      "then": {
        "properties": {
          "agent_name": { "const": "PROPOSAL_AGENT" },
          "output_schema_id": { "const": "caffemate.agent.franchise-proposal-result.v1" },
          "payload": {
            "anyOf": [
              { "$ref": "./agent-role-payloads.schema.json#/$defs/franchiseProposalResult" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "task_type": { "const": "DOCUMENT_EXTRACT" } }
      },
      "then": {
        "properties": {
          "agent_name": { "const": "DOCUMENT_ANALYST" },
          "output_schema_id": { "const": "caffemate.agent.document-extract-result.v1" },
          "payload": {
            "anyOf": [
              { "$ref": "./agent-role-payloads.schema.json#/$defs/documentExtractResult" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "task_type": { "const": "CANDIDATE_AUDIT" } }
      },
      "then": {
        "properties": {
          "agent_name": { "const": "TYPED_CANDIDATE_AUDITOR" },
          "output_schema_id": { "const": "caffemate.agent.candidate-audit-result.v1" },
          "payload": {
            "anyOf": [
              { "$ref": "./agent-role-payloads.schema.json#/$defs/candidateAuditResult" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  ]
}
