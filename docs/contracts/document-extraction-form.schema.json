{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-bootcamp-team4/CaffeMate/docs/contracts/document-extraction-form.schema.json",
  "title": "CaffeMate Document Extraction Form",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "form_id",
    "project_id",
    "document_id",
    "document_revision_id",
    "expected_state_version",
    "form_status",
    "fields",
    "apply_label"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "form_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "document_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_state_version": {
      "type": "integer",
      "minimum": 1
    },
    "form_status": {
      "enum": ["READY", "HAS_UNRESOLVED", "APPLIED", "STALE"]
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extractionField"
      },
      "minItems": 1
    },
    "apply_label": {
      "const": "반영하고 다시 계산"
    },
    "applied_state_version": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  },
  "$defs": {
    "editableValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "anchor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["document_revision_id"],
      "properties": {
        "document_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "page_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "section_path": {
          "type": ["string", "null"]
        },
        "table_id": {
          "type": ["string", "null"]
        },
        "row": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "column": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "bbox": {
          "type": ["array", "null"],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 8
        }
      }
    },
    "extractionField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "claim_type",
        "label",
        "raw_value_text",
        "extracted_value",
        "current_value",
        "unit",
        "materiality",
        "extraction_status",
        "edit_status",
        "anchor",
        "warnings"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "raw_value_text": {
          "type": ["string", "null"]
        },
        "extracted_value": {
          "$ref": "#/$defs/editableValue"
        },
        "current_value": {
          "$ref": "#/$defs/editableValue"
        },
        "unit": {
          "type": ["string", "null"]
        },
        "materiality": {
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "extraction_status": {
          "enum": ["AUTO_FILLED", "REVIEW_REQUIRED", "UNRESOLVED"]
        },
        "edit_status": {
          "enum": ["UNCHANGED", "EDITED", "CLEARED"]
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
