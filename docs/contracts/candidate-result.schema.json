{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-bootcamp-team4/CaffeMate/docs/contracts/candidate-result.schema.json",
  "title": "CaffeMate Candidate Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "project_id",
    "state_version",
    "case_type",
    "display_name",
    "review_status",
    "reason_codes",
    "summary",
    "rank",
    "rank_basis",
    "is_primary_next_review",
    "evidence_refs",
    "financial_summary",
    "missing_fields",
    "risks",
    "counterfactuals",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "case_type": {
      "enum": ["INDEPENDENT", "FRANCHISE"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": ["REVIEW_RECOMMENDED", "CONDITIONAL_REVIEW", "EXCLUDED"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rank": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "rank_basis": {
      "enum": ["ECONOMIC_AND_FOUNDER_FIT", "NEXT_REVIEW_PRIORITY", "NOT_RANKED"]
    },
    "is_primary_next_review": {
      "type": "boolean"
    },
    "franchise": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["brand_id", "eligibility", "availability_status", "eligibility_evidence_refs", "disclosure_evidence_refs"],
      "properties": {
        "brand_id": {
          "type": ["string", "null"]
        },
        "eligibility": {
          "enum": ["VERIFIED", "UNVERIFIED", "INELIGIBLE"]
        },
        "availability_status": {
          "enum": ["AVAILABLE", "HQ_CONFIRMATION_REQUIRED", "UNAVAILABLE", "UNKNOWN"]
        },
        "eligibility_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "disclosure_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "independent_model": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["model_id", "adjusted_fields"],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "adjusted_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assumption_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "financial_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_cash", "monthly_fixed_cost", "unknown_cost_fields"],
      "properties": {
        "initial_cash": {
          "$ref": "#/$defs/moneyRange"
        },
        "monthly_fixed_cost": {
          "$ref": "#/$defs/moneyRange"
        },
        "break_even_monthly_sales_krw": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "required_daily_orders": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "unknown_cost_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missingField"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "counterfactuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counterfactual"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "case_type": {
            "const": "FRANCHISE"
          }
        }
      },
      "then": {
        "required": ["franchise"],
        "properties": {
          "franchise": {
            "type": "object"
          },
          "independent_model": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_type": {
            "const": "INDEPENDENT"
          }
        }
      },
      "then": {
        "required": ["independent_model"],
        "properties": {
          "independent_model": {
            "type": "object"
          },
          "franchise": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "REVIEW_RECOMMENDED"
          }
        }
      },
      "then": {
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "rank_basis": {
            "const": "ECONOMIC_AND_FOUNDER_FIT"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1
          },
          "financial_summary": {
            "type": "object",
            "properties": {
              "initial_cash": { "$ref": "#/$defs/knownMoneyRange" },
              "monthly_fixed_cost": { "$ref": "#/$defs/knownMoneyRange" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_type": { "const": "FRANCHISE" },
          "franchise": {
            "type": "object",
            "properties": { "eligibility": { "enum": ["UNVERIFIED", "INELIGIBLE"] } },
            "required": ["eligibility"]
          }
        },
        "required": ["franchise"]
      },
      "then": {
        "properties": {
          "review_status": { "const": "EXCLUDED" },
          "rank": { "const": null },
          "rank_basis": { "const": "NOT_RANKED" },
          "is_primary_next_review": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_type": { "const": "FRANCHISE" },
          "review_status": { "enum": ["REVIEW_RECOMMENDED", "CONDITIONAL_REVIEW"] }
        }
      },
      "then": {
        "properties": {
          "franchise": {
            "type": "object",
            "properties": {
              "eligibility": { "const": "VERIFIED" },
              "brand_id": { "type": "string", "minLength": 1 },
              "eligibility_evidence_refs": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "CONDITIONAL_REVIEW"
          }
        }
      },
      "then": {
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "rank_basis": {
            "const": "NEXT_REVIEW_PRIORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "EXCLUDED"
          }
        }
      },
      "then": {
        "properties": {
          "rank": {
            "const": null
          },
          "rank_basis": {
            "const": "NOT_RANKED"
          },
          "is_primary_next_review": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "moneyRange": {
      "oneOf": [
        { "$ref": "#/$defs/knownMoneyRange" },
        { "$ref": "#/$defs/unknownMoneyRange" }
      ]
    },
    "knownMoneyRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "low", "base", "high", "provenance_refs"],
      "properties": {
        "currency": {
          "const": "KRW"
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "unknownMoneyRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "low", "base", "high", "provenance_refs"],
      "properties": {
        "currency": { "const": "KRW" },
        "low": { "const": null },
        "base": { "const": null },
        "high": { "const": null },
        "provenance_refs": { "type": "array", "maxItems": 0 }
      }
    },
    "missingField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "impact", "next_check"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "next_check": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "severity", "summary", "evidence_refs"],
      "properties": {
        "risk_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "counterfactual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "condition", "decision_impact"],
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "decision_impact": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
