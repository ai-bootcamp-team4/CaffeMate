{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-bootcamp-team4/CaffeMate/docs/contracts/candidate-result.schema.json",
  "title": "CaffeMate Candidate Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "project_id",
    "state_version",
    "case_type",
    "display_name",
    "review_status",
    "reason_codes",
    "summary",
    "rank",
    "rank_basis",
    "is_primary_next_review",
    "evidence_refs",
    "financial_summary",
    "missing_fields",
    "risks",
    "counterfactuals",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "case_type": {
      "enum": ["INDEPENDENT", "FRANCHISE"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": ["REVIEW_RECOMMENDED", "CONDITIONAL_REVIEW", "EXCLUDED"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rank": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "rank_basis": {
      "enum": ["ECONOMIC_AND_FOUNDER_FIT", "NEXT_REVIEW_PRIORITY", "NOT_RANKED"]
    },
    "is_primary_next_review": {
      "type": "boolean"
    },
    "franchise": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["brand_id", "eligibility", "availability_status", "eligibility_evidence_refs", "disclosure_evidence_refs"],
      "properties": {
        "brand_id": {
          "type": ["string", "null"]
        },
        "eligibility": {
          "enum": ["VERIFIED", "UNVERIFIED", "INELIGIBLE"]
        },
        "availability_status": {
          "enum": ["AVAILABLE", "HQ_CONFIRMATION_REQUIRED", "UNAVAILABLE", "UNKNOWN"]
        },
        "eligibility_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "disclosure_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "finance_profile": {
          "$ref": "./mcp-tool-contracts.schema.json#/$defs/franchiseFinanceProfile"
        }
      }
    },
    "independent_model": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["model_id", "adjusted_fields"],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "adjusted_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "property_context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "property_input_id",
        "address",
        "area_sqm",
        "floor",
        "deposit_krw",
        "monthly_rent_krw",
        "management_fee_krw",
        "key_money_krw",
        "provenance"
      ],
      "properties": {
        "property_input_id": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1, "maxLength": 256 },
        "area_sqm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "floor": { "type": ["string", "null"], "maxLength": 32 },
        "deposit_krw": { "type": "integer", "minimum": 0 },
        "monthly_rent_krw": { "type": "integer", "minimum": 0 },
        "management_fee_krw": { "type": "integer", "minimum": 0 },
        "key_money_krw": { "type": ["integer", "null"], "minimum": 0 },
        "provenance": { "const": "USER_INPUT" }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assumption_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "market_signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marketSignal"
      }
    },
    "official_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/officialDocument"
      }
    },
    "official_document_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gate_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gateResult"
      },
      "maxItems": 8
    },
    "rank_trace": {
      "oneOf": [
        { "$ref": "#/$defs/rankTrace" },
        { "type": "null" }
      ]
    },
    "decision_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decisionInput"
      }
    },
    "verification_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationRequirement"
      }
    },
    "agent_advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit_assessments", "adjusted_parameters", "missing_fields", "warnings"],
      "properties": {
        "fit_assessments": {
          "type": "array",
          "items": {
            "$ref": "./agent-role-payloads.schema.json#/$defs/candidateFitAssessment"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "adjusted_parameters": {
          "type": "array",
          "items": {
            "$ref": "./agent-role-payloads.schema.json#/$defs/adjustedParameter"
          }
        },
        "missing_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "financial_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_cash", "monthly_fixed_cost", "unknown_cost_fields"],
      "properties": {
        "initial_cash": {
          "$ref": "#/$defs/moneyRange"
        },
        "monthly_fixed_cost": {
          "$ref": "#/$defs/moneyRange"
        },
        "break_even_monthly_sales_krw": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "required_daily_orders": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "unknown_cost_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missingField"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "counterfactuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counterfactual"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "case_type": {
            "const": "FRANCHISE"
          }
        }
      },
      "then": {
        "required": ["franchise"],
        "properties": {
          "franchise": {
            "type": "object"
          },
          "independent_model": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_type": {
            "const": "INDEPENDENT"
          }
        }
      },
      "then": {
        "required": ["independent_model"],
        "properties": {
          "independent_model": {
            "type": "object"
          },
          "franchise": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "REVIEW_RECOMMENDED"
          }
        }
      },
      "then": {
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "rank_basis": {
            "const": "ECONOMIC_AND_FOUNDER_FIT"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1
          },
          "financial_summary": {
            "type": "object",
            "properties": {
              "initial_cash": { "$ref": "#/$defs/knownMoneyRange" },
              "monthly_fixed_cost": { "$ref": "#/$defs/knownMoneyRange" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_type": { "const": "FRANCHISE" },
          "franchise": {
            "type": "object",
            "properties": { "eligibility": { "enum": ["UNVERIFIED", "INELIGIBLE"] } },
            "required": ["eligibility"]
          }
        },
        "required": ["franchise"]
      },
      "then": {
        "properties": {
          "review_status": { "const": "EXCLUDED" },
          "rank": { "const": null },
          "rank_basis": { "const": "NOT_RANKED" },
          "is_primary_next_review": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_type": { "const": "FRANCHISE" },
          "review_status": { "enum": ["REVIEW_RECOMMENDED", "CONDITIONAL_REVIEW"] }
        }
      },
      "then": {
        "properties": {
          "franchise": {
            "type": "object",
            "properties": {
              "eligibility": { "const": "VERIFIED" },
              "brand_id": { "type": "string", "minLength": 1 },
              "eligibility_evidence_refs": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "CONDITIONAL_REVIEW"
          }
        }
      },
      "then": {
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "rank_basis": {
            "const": "NEXT_REVIEW_PRIORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "EXCLUDED"
          }
        }
      },
      "then": {
        "properties": {
          "rank": {
            "const": null
          },
          "rank_basis": {
            "const": "NOT_RANKED"
          },
          "is_primary_next_review": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "resolutionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "target_fields", "accepted_document_types"],
      "properties": {
        "action_type": {
          "enum": [
            "PROPERTY_TERMS",
            "DOCUMENT_INTAKE",
            "USER_INPUT",
            "EXTERNAL_CONFIRMATION",
            "NONE"
          ]
        },
        "target_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "accepted_document_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "decisionMoneyRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "base", "high"],
      "properties": {
        "low": { "type": ["integer", "null"], "minimum": 0 },
        "base": { "type": ["integer", "null"], "minimum": 0 },
        "high": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "decisionDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula_code", "inputs"],
      "properties": {
        "formula_code": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object" },
        "coverage_status": { "type": ["string", "null"], "minLength": 1 },
        "floor_basis": { "type": ["string", "null"], "minLength": 1 },
        "source_version": { "type": ["string", "null"], "minLength": 1 },
        "reporting_year": { "type": ["integer", "null"], "minimum": 2000, "maximum": 2100 },
        "constituent_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "decisionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value_range_krw",
        "provenance",
        "resolution_status",
        "decision_role",
        "source_title",
        "source_ref",
        "data_date",
        "geographic_scope",
        "source_anchor",
        "applied_to",
        "replaceable_by",
        "resolution_action",
        "limitation_code",
        "derivation"
      ],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "value_range_krw": { "$ref": "#/$defs/decisionMoneyRange" },
        "provenance": {
          "enum": ["FACT", "USER_INPUT", "BENCHMARK", "ASSUMPTION", "DERIVED", "UNKNOWN"]
        },
        "resolution_status": {
          "enum": [
            "RESOLVED_FACT",
            "RESOLVED_USER_CONFIRMED",
            "RESOLVED_BENCHMARK",
            "RESOLVED_DERIVED",
            "ASSUMED",
            "INPUT_REQUIRED",
            "DOCUMENT_REQUIRED",
            "EXTERNAL_CONFIRMATION_REQUIRED",
            "UNSUPPORTED_BY_DATA"
          ]
        },
        "decision_role": {
          "enum": ["FINANCE_INPUT", "CONSTRAINT_INPUT", "VERIFICATION_ONLY", "CONTEXT_ONLY"]
        },
        "source_title": { "type": ["string", "null"], "minLength": 1 },
        "source_ref": { "type": ["string", "null"], "minLength": 1 },
        "data_date": { "type": ["string", "null"], "format": "date" },
        "geographic_scope": {
          "oneOf": [
            { "$ref": "./common-types.schema.json#/$defs/geographicScope" },
            { "type": "null" }
          ]
        },
        "source_anchor": { "type": ["string", "null"], "minLength": 1 },
        "applied_to": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "replaceable_by": {
          "type": "array",
          "items": {
            "enum": [
              "PROPERTY_TERMS",
              "DOCUMENT_INTAKE",
              "USER_INPUT",
              "EXTERNAL_CONFIRMATION",
              "NONE"
            ]
          },
          "uniqueItems": true
        },
        "resolution_action": { "$ref": "#/$defs/resolutionAction" },
        "limitation_code": { "type": ["string", "null"], "minLength": 1 },
        "derivation": {
          "oneOf": [
            { "$ref": "#/$defs/decisionDerivation" },
            { "type": "null" }
          ]
        }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_type", "status", "reason_code", "decisive_input_refs", "metrics"],
      "properties": {
        "gate_type": { "const": "CAPITAL" },
        "status": { "enum": ["PASS", "CONDITIONAL", "FAIL"] },
        "reason_code": { "type": "string", "minLength": 1 },
        "decisive_input_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "own_funds_krw",
            "minimum_required_krw",
            "maximum_required_krw",
            "shortfall_krw"
          ],
          "properties": {
            "own_funds_krw": { "type": "integer", "minimum": 0 },
            "minimum_required_krw": { "type": ["integer", "null"], "minimum": 0 },
            "maximum_required_krw": { "type": ["integer", "null"], "minimum": 0 },
            "shortfall_krw": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },
    "rankTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranking_class",
        "factors",
        "decisive_factor_code",
        "compared_candidate_id",
        "tie_break_used"
      ],
      "properties": {
        "ranking_class": { "type": "string", "minLength": 1 },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factor_code", "value", "direction"],
            "properties": {
              "factor_code": { "type": "string", "minLength": 1 },
              "value": {
                "oneOf": [
                  { "type": "integer" },
                  { "type": "string" },
                  { "type": "null" }
                ]
              },
              "direction": { "enum": ["ASC", "DESC"] }
            }
          }
        },
        "decisive_factor_code": { "type": ["string", "null"], "minLength": 1 },
        "compared_candidate_id": { "type": ["string", "null"], "minLength": 1 },
        "tie_break_used": { "type": "boolean" }
      }
    },
    "verificationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "status",
        "decision_role",
        "resolver",
        "reason_code",
        "required_evidence",
        "resolution_action",
        "why_caffemate_cannot_resolve"
      ],
      "properties": {
        "requirement_id": { "type": "string", "minLength": 1 },
        "status": { "const": "EXTERNAL_CONFIRMATION_REQUIRED" },
        "decision_role": { "const": "VERIFICATION_ONLY" },
        "resolver": { "type": "string", "minLength": 1 },
        "reason_code": { "type": "string", "minLength": 1 },
        "required_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "resolution_action": { "$ref": "#/$defs/resolutionAction" },
        "why_caffemate_cannot_resolve": { "type": "string", "minLength": 1 }
      }
    },
    "marketSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_type",
        "decision_role",
        "value",
        "unit",
        "data_date",
        "freshness_status",
        "source_title",
        "source_ref",
        "evidence_id",
        "caveat"
      ],
      "properties": {
        "signal_type": {
          "enum": [
            "CAFE_COUNT",
            "OPEN_COUNT",
            "CLOSE_COUNT",
            "CLOSURE_RATE",
            "ESTIMATED_SALES",
            "FOOT_TRAFFIC",
            "RESIDENT_POPULATION",
            "WORKER_POPULATION"
          ]
        },
        "decision_role": {
          "const": "CONTEXT_ONLY"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": ["string", "null"]
        },
        "data_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "freshness_status": {
          "enum": ["FRESH", "STALE", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "caveat": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "officialDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_ref",
        "data_date",
        "freshness_status",
        "document_version",
        "excerpt",
        "source_family",
        "claim_types",
        "purposes",
        "evidence_refs",
        "used_in_candidate"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "data_date": { "type": ["string", "null"], "format": "date" },
        "freshness_status": {
          "enum": ["FRESH", "STALE", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "document_version": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "source_family": { "type": "string", "minLength": 1 },
        "claim_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "purposes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "used_in_candidate": { "type": "boolean" }
      }
    },
    "moneyRange": {
      "oneOf": [
        { "$ref": "#/$defs/knownMoneyRange" },
        { "$ref": "#/$defs/unknownMoneyRange" }
      ]
    },
    "knownMoneyRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "low", "base", "high", "provenance_refs"],
      "properties": {
        "currency": {
          "const": "KRW"
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "unknownMoneyRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "low", "base", "high", "provenance_refs"],
      "properties": {
        "currency": { "const": "KRW" },
        "low": { "const": null },
        "base": { "const": null },
        "high": { "const": null },
        "provenance_refs": { "type": "array", "maxItems": 0 }
      }
    },
    "missingField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "impact", "next_check"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "next_check": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "severity", "summary", "evidence_refs"],
      "properties": {
        "risk_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
