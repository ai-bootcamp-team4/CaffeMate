{
  "name": "caffemate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite --mode ui-only",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check:api": "uv run --project api ruff check api worker && uv run --project api mypy --config-file api/pyproject.toml api/app worker && uv run --project api pytest api/tests",
    "test:agents": "vitest run agents/test mcp/test rag/test worker/pipelines/**/*.test.ts",
    "typecheck:agents": "tsc -p tsconfig.agents.json --pretty false",
    "agent:control": "tsx agents/src/control-cli.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:api",
    "build:ui-only": "vite build --config vite.ui-only.config.ts",
    "export:ui-only": "npm run typecheck && npm run build:ui-only && tsx scripts/export-ui-only.ts"
  },
  "dependencies": {
    "@google/adk": "1.6.0",
    "@google/adk-devtools": "1.6.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "firebase": "^12.18.0",
    "google-auth-library": "11.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "tar": "7.5.22"
  }
}
